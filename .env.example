# Copy this file to .env and fill values for your environment.
# Mailtrap example (recommended for development/testing):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_mailtrap_user
EMAIL_HOST_PASSWORD=your_mailtrap_password
DEFAULT_FROM_EMAIL=your@example.com

# Other useful vars (already defaulted in docker-compose):
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
DATABASE_URL=postgres://technova_user:technova_password@db:5432/technova_support

# Render deploy secrets (set in Render dashboard, do NOT commit):
# RENDER_API_KEY=
# RENDER_SERVICE_ID_BACKEND=
# RENDER_SERVICE_ID_FRONTEND=
